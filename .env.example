# Copier ce fichier en .env puis saisir la clé localement.
# Le mode --demo utilise uniquement la clé publique de démonstration.
EODHD_API_TOKEN=

# Facultatif : modèle déjà installé, uniquement avec --backend ollama.
STOCKBOT_OLLAMA_MODEL=
# Configurer OLLAMA_NO_CLOUD=1 sur le SERVEUR Ollama puis le redémarrer.
# Cette variable placée dans le .env du bot ne reconfigure pas un serveur existant.

# Facultatif : messages uniquement avec l'option explicite --notify-telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
